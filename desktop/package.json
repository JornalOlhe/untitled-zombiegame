{
  "name": "dead-recoil-desktop",
  "version": "0.22.0",
  "private": true,
  "description": "Dead Recoil desktop runtime for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.deadrecoil.game.desktop",
    "productName": "Dead Recoil",
    "asar": true,
    "artifactName": "DeadRecoil-Setup-${version}.exe",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../android/app/src/main/assets",
        "to": "game",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Dead Recoil",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Dead Recoil"
    },
    "protocols": [
      {
        "name": "Dead Recoil login",
        "schemes": [
          "untitledzombie"
        ]
      }
    ]
  }
}
