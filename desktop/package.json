{
  "name": "dead-recoil-desktop",
  "version": "0.12.0",
  "private": true,
  "description": "Dead Recoil desktop runtime for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.deadrecoil.game.desktop",
    "productName": "Dead Recoil",
    "asar": true,
    "artifactName": "DeadRecoil-Windows.exe",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../android/app/src/main/assets",
        "to": "game",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
